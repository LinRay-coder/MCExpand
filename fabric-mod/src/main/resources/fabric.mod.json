{
	"schemaVersion": 1,
	"id": "mcexpand",
	"version": "${version}",

	"name": "MCExpand",
	"description": "A Fabric mod for Minecraft 26.3: adds multiple equipment sets (lapis / emerald / amethyst) with spears, plus many stone building variants (stairs / slabs / walls, including smooth / cut / chiseled).",
	"authors": [
		"You"
	],
	"contact": {},

	"license": "GPL-3.0-only",
	"icon": "assets/mcexpand/icon.png",

	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.mcexpand.MCExpand"
		],
		"client": [
			"com.example.mcexpand.client.MCExpandClient"
		],
		"fabric-datagen": [
			"com.example.mcexpand.datagen.MCExpandDataGenerator"
		]
	},
	"mixins": [],

	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {}
